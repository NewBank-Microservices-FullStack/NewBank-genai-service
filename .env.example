# Copy to .env (never commit .env). See src/main/resources/application.yml.
# #6: secrets come from env, never from classpath:/creds.yaml
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JWT_ISSUER_URI=https://auth.newbank.local/realms/newbank
EUREKA_URI=http://discovery:8761/eureka
USER_SERVICE_URL=http://user-service
ACCOUNT_SERVICE_URL=http://account-service
TRANSACTION_SERVICE_URL=http://transaction-service
ADVISORS_URL=http://advisors-service
VECTOR_STORE_TYPE=memory
# VECTOR_STORE_TYPE=pgvector
PGVECTOR_JDBC_URL=jdbc:postgresql://postgres:5432/vectordb
PGVECTOR_USERNAME=vectordb
PGVECTOR_PASSWORD=change-me
MAX_PROMPT_CHARS=4000
RATE_LIMIT_PER_MINUTE=30
